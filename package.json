{
  "name": "a2a-mcp",
  "version": "1.0.0",
  "description": "A proxy tool that converts normal MCP servers to use lazy-loading pattern with three/four meta-tools",
  "main": "dist/server.js",
  "bin": {
    "a2a-mcp": "dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khulnasoft/a2a-mcp.git"
  },
  "homepage": "https://github.com/khulnasoft/a2a-mcp#readme",
  "bugs": {
    "url": "https://github.com/khulnasoft/a2a-mcp/issues"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "mcp",
    "a2a-mcp",
    "mcp-server",
